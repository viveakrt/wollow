# Copy to .env and fill in before running `docker compose up`.

# AES-256 key used to encrypt IMAP passwords, AI API keys and issuer PDF
# passwords at rest. Losing it means reconnecting every account.
# Generate with: openssl rand -hex 32
WOLLOW_MASTER_KEY=

# Password required to log into the Wollow web UI (single-user mode).
WOLLOW_ADMIN_PASSWORD=

# Secret used to sign session tokens. Must be at least 32 characters — a short
# one can be brute-forced offline from a single captured cookie.
# Generate with: openssl rand -hex 32
WOLLOW_JWT_SECRET=

# Set to "true" if serving over HTTPS so the session cookie gets the Secure flag.
WOLLOW_COOKIE_SECURE=false

# Port the web UI is exposed on the host.
WOLLOW_PORT=8081

# Browser origins allowed to make credentialed cross-origin API calls, comma
# separated (e.g. https://wollow.example.com). Leave empty unless you serve the
# UI from a different origin than the API: the compose setup and the single
# binary both put them on one origin, where CORS never applies. An entry here
# grants that origin authenticated access to your mail and transactions.
WOLLOW_ALLOWED_ORIGINS=

# How many messages the AI classifier processes concurrently.
WOLLOW_CLASSIFY_CONCURRENCY=3
